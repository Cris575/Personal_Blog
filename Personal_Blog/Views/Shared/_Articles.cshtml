@model IEnumerable<Articles>

<div class="articles-list">
    @foreach (var article in Model)
    {
        <article class="article-card">
            <div class="article-date">@article.Date</div>
            <h3>
                <a asp-controller="Articles" asp-action="Index" asp-route-id="@article.Id">@article.Title</a>
            </h3>

            @if (User.Identity is { IsAuthenticated: true } && User.IsInRole("admin"))
            {
                <div class="article-actions">
                    <a asp-controller="Articles" asp-action="Edit" asp-route-id="@article.Id">Edit</a>
                    <a asp-controller="Articles" asp-action="Delete" asp-route-id="@article.Id"
                       onclick="return confirm('Are you sure you want to delete this article?');">
                        Delete
                    </a>
                </div>
            }
        </article>
    }
</div>